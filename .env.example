# Explorer counts. When this file exists, the Explore tab reads it instead of Turso.
# Leave unset to use `.data/explorer-2026-09.sqlite` if that file is present.
# EXPLORER_DATABASE_PATH=

# Turso. Opening cards still use this. Explorer falls back here only when the local file is missing.
# Local dev and Vercel Preview: the dev database.
# Vercel Production: the prod database.
# TURSO_DATABASE_TURSO_AUTH_TOKEN is accepted as the same token.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Home explorer gateway. The month files stay on this machine.
# Vercel sets both. Local dev sets both to http://127.0.0.1:3921 and the same secret.
# The gateway process itself must not set EXPLORER_ORIGIN, or it would call itself.
# EXPLORER_ORIGIN=https://your-tunnel.example
# EXPLORER_GATEWAY_SECRET=

# Local coach auth. On Vercel, AI Gateway uses VERCEL_OIDC_TOKEN instead.
# Create a key under the project → AI Gateway → API keys.
# AI_GATEWAY_API_KEY=

# Optional AI Gateway model override
# AI_COACH_MODEL=deepseek/deepseek-v4.1-flash

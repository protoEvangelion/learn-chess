# Turso (required in production; local development falls back to `.data/opening-cards.db`)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Lichess Opening Explorer. Anonymous requests are rejected (401).
# Create a personal token at https://lichess.org/account/oauth/token
# Set it here for `npm run dev`, and on the Vercel project for production.
LICHESS_API_TOKEN=

# Local coach auth. On Vercel, AI Gateway uses VERCEL_OIDC_TOKEN instead.
# Create a key under the project → AI Gateway → API keys.
# AI_GATEWAY_API_KEY=

# Optional AI Gateway model override
# AI_COACH_MODEL=deepseek/deepseek-v4.1-flash

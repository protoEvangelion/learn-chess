{
  "functions": {
    "api/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/explorer-months",
      "destination": "/api/opening-explorer?view=months"
    },
    {
      "source": "/api/cloud-eval",
      "destination": "/api/opening-explorer?view=cloud-eval"
    }
  ],
  "crons": [
    {
      "path": "/api/explore-cache",
      "schedule": "0 0 * * 0"
    }
  ]
}
